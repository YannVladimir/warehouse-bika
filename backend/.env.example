# Copy to .env and adjust for your machine. docker-compose and Spring Boot both read these.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bika_archive
DB_USER=bika
DB_PASSWORD=bika_dev_password

SERVER_PORT=8080

# Must be at least 32 bytes for HS256. Generate a real one before deploying anywhere shared.
JWT_SECRET=this-is-a-dev-only-secret-key-change-in-production-min-32-bytes
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Refresh token cookie. Keep COOKIE_SECURE=false for plain http://localhost dev.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Pattern (not exact match) so any local Vite/dev-server port works -- this machine tends to have
# port conflicts across projects, so the frontend doesn't always land on 5173.
CORS_ALLOWED_ORIGINS=http://localhost:*

# First-run bootstrap SUPER_ADMIN (only created if the users table is empty). Change the password after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@bika.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME="System Administrator"

# SMTP for password-reset emails. Fill in with your provider's credentials -- do not commit real
# credentials into this template file.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com

# Base URL of the frontend, used to build links in emails (e.g. the password reset link).
FRONTEND_URL=http://localhost:5180

# Signing secret for short-lived "file in Archive" handoff tokens minted by the bika DMS.
# Must match the bika DMS's ARCHIVE_HANDOFF_SECRET exactly -- generate with `openssl rand -hex 32`.
# Deliberately a separate secret from JWT_SECRET: a leak here should only forge a handoff, not a
# real login session.
ARCHIVE_HANDOFF_SECRET=generate-a-separate-32-byte-hex-secret-shared-with-the-bika-dms

# One-way sync of companies from the bika DMS (GET /v1/companies/export). Set
# BIKA_SOURCE_SYNC_ENABLED=false until the bika DMS side is actually reachable.
BIKA_SOURCE_BASE_URL=http://localhost:8081/api
BIKA_SOURCE_API_KEY=generate-a-32-byte-hex-key-shared-with-the-bika-dms
BIKA_SOURCE_SYNC_ENABLED=false
